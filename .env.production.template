# Zolai-AI Production Environment Template
# Copy to .env.production and fill in actual values.
# NEVER commit .env.production — it contains secrets.

###############################################################################
# CORE API (zolai-core)
###############################################################################

# API-key auth on /api/v1 (ADR-014)
# warn (default, dual-accept window) | enforce (401 without a key) | off
ZOLAI_API_AUTH=warn

# Per-key rate limit in requests/minute (in-memory token bucket)
ZOLAI_API_RATE_LIMIT_RPM=60

# Username accounts + revocable sessions (POST /api/v1/auth/login|logout)
# on (default) | off  — off makes login/logout 404 and middleware ignore tokens
ZOLAI_AUTH_SESSIONS=on

# Session lifetime in hours (default 12)
ZOLAI_SESSION_TTL_HOURS=12

# Login attempts per minute per client IP (default 5) and per username (default 10)
ZOLAI_LOGIN_RATE_LIMIT_RPM=5
ZOLAI_LOGIN_RATE_LIMIT_USER_RPM=10

# Database path (inside container this is /app/data/zolai.db via volume mount)
ZOLAI_DB_PATH=/data/zolai.db

# Log level
ZOLAI_LOG_LEVEL=INFO

###############################################################################
# AI PROVIDERS (zolai-core)
###############################################################################

# pcore-brain (first-class provider, used by default)
AI_BRAIN_URL=https://pcore-brain.peterlianpi.site/v1
AI_BRAIN_API_KEY=<brain-api-key>

# Optional: other provider keys (only needed if you enable them in admin UI)
# OPENAI_API_KEY=<openai-key>
# OPENROUTER_API_KEY=<openrouter-key>
# GEMINI_API_KEY=<gemini-key>

###############################################################################
# NOTIFICATIONS (zolai-core)
###############################################################################

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=peterpausianlian2020@gmail.com
SMTP_PASS=<gmail-app-password>
SMTP_FROM=pcore.system@gmail.com
SMTP_TLS=true
ADMIN_EMAILS=peterpausianlian2020@gmail.com
ZOLAI_NOTIFICATIONS_ENABLED=true

###############################################################################
# CIRCUIT BREAKER (zolai-core)
###############################################################################

ZOLAI_CB_FAILURE_THRESHOLD=5
ZOLAI_CB_TIMEOUT=30
ZOLAI_CB_SUCCESS_THRESHOLD=2
ZOLAI_CB_ENABLED=true

###############################################################################
# STUDIO (zolai-explorer)
###############################################################################

# Base path for the versioned API surface (absolute URL for cross-origin SPA)
VITE_API_BASE=https://api.zolai.space/api/v1

# Upstream host used by Vite dev proxy (bun run dev)
ZOLAI_UPSTREAM=https://api.zolai.space